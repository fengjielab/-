# Normalize repository text files to LF.
* text=auto

*.c   text eol=lf
*.h   text eol=lf
*.s   text eol=lf
*.ld  text eol=lf
*.ioc text eol=lf
*.xml text eol=lf
*.py  text eol=lf
*.md  text eol=lf

# Keep binary assets unchanged.
*.jpg  binary
*.jpeg binary
*.png  binary
*.mp4  binary
*.bin  binary
